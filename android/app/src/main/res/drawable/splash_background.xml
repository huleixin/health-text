<?xml version="1.0" encoding="utf-8"?>
<!-- Splash background: dark web bg + centered logo (sized so it never gets cropped). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/splash_bg" />
    </item>
    <item
        android:gravity="center"
        android:width="132dp"
        android:height="132dp">
        <bitmap
            android:src="@drawable/ic_launcher_logo"
            android:gravity="fill" />
    </item>
</layer-list>
