<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: the full logo inset to ~68% so the gold subject
     sits well inside the 66dp safe zone — guaranteed no cropping by launcher masks. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16%"
    android:insetRight="16%"
    android:insetTop="16%"
    android:insetBottom="16%">
    <bitmap
        android:src="@drawable/ic_launcher_logo"
        android:gravity="fill" />
</inset>
